# ─────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; this file is not — so keep every
# value here a placeholder or a non-sensitive default. Never paste a real key.
#
# Anything not listed here falls back to the default in app/core/config.py.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# GCP Configuration
# ─────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# Leave blank on Cloud Run — it uses Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# ─────────────────────────────────────────────
# Vertex AI / Gemini
# ─────────────────────────────────────────────
VERTEX_AI_LOCATION=us-central1
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite
# Hard cap on a single LLM call, so a stalled request can't hang a turn.
LLM_CALL_TIMEOUT_SECONDS=45

# Staying inside Vertex's shared quota. Gemini on Vertex runs on DYNAMIC SHARED QUOTA:
# a 429 means the pool is busy and there is NO quota increase to request. The only
# levers are sending fewer requests and spreading them out; these are those levers.
# All three have working defaults in config.py, so production gets them without the
# deploy passing anything.
#
# LangChain's own retry, which is invisible: ChatVertexAI defaults to 6, and six
# retries into an exhausted pool is six more requests that will also fail.
# A SECOND model, used only when the first has no capacity. Quota is PER MODEL and the
# pools differ: measured during an outage, flash-lite returned 429 on 8 of 8 calls while
# flash answered 8 of 8, same region, same minute. Set to "" to disable.
# If the primary stays down for a long stretch, just point GEMINI_FLASH_MODEL at the
# model that works - that skips the failed first attempt and its ~4s of latency.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

VERTEX_MAX_RETRIES=2
# Token-bucket pacing, PER PROCESS - with --max-instances=10 the fleet rate is 10x.
VERTEX_REQUESTS_PER_SECOND=4
VERTEX_BURST_SIZE=8
# Hard ceiling on concurrent in-flight calls per process. The limiter paces STARTS;
# this bounds how many are open at once when Vertex is slow.
VERTEX_MAX_IN_FLIGHT=8

# ─────────────────────────────────────────────
# Firebase Auth
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# ─────────────────────────────────────────────
# Firestore — the system of record for conversations
# ─────────────────────────────────────────────
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_SESSIONS_COLLECTION=trip_sessions
FIRESTORE_USERS_COLLECTION=user_profiles
FIRESTORE_ACTIVE_CHATS_COLLECTION=active_chats

# ─────────────────────────────────────────────
# Geography — resolved live, per request
# ─────────────────────────────────────────────
# There are NO coordinates, road distances or drive times stored in this codebase.
# Places are geocoded and routes are measured on demand. Both defaults are keyless
# public services; point them at self-hosted instances before production traffic.
#
# Nominatim-compatible. It also tells us which STATE a place is in, which is how a
# rider is classified local vs visitor — no boundary polygon of our own.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim rejects anonymous traffic. Identify your deployment, with contact info.
GEOCODING_USER_AGENT=HimCabTravelAssistant/1.0 (support@himcab.example)
GEOCODING_COUNTRY_CODES=in
GEOCODING_CACHE_TTL_SECONDS=86400     # 24 h — a town does not move between messages

# OSRM-compatible `/route/v1` shape. Supplies the real road distance the fare is
# priced on and the drive time quoted to the rider.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_PATH=/route/v1/driving
ROUTING_CACHE_TTL_SECONDS=21600       # 6 h

# ─────────────────────────────────────────────
# External APIs
# ─────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweather-api-key
# In-process weather cache (there is no cache server — see services/local_cache.py).
WEATHER_CACHE_TTL_SECONDS=1800

# ─────────────────────────────────────────────
# Him Cab Java/Spring backend (real cab fares)
# ─────────────────────────────────────────────
JAVA_BACKEND_URL=http://your-fare-host:9002
ENABLE_REAL_FARES=true
HIMCAB_FARE_PATH=/api/rider/fare/estimate
HIMCAB_FARE_GETALL_PATH=/api/rider/fare/get-all
HIMCAB_FARE_TIMEOUT_SECONDS=10

# ─────────────────────────────────────────────
# Him Cab offers (real coupons, same backend)
# ─────────────────────────────────────────────
# The assistant quotes ONLY coupons this returns. Set ENABLE_OFFERS=false and it goes
# back to never mentioning a discount at all.
ENABLE_OFFERS=true
# `{riderId}` is substituted with the id read from the rider's JWT claims. When the
# token carries no id claim, the unpersonalised list below is used and filtered locally.
HIMCAB_OFFERS_BY_TRIP_TYPE_PATH=/api/rider/offer/getOffersByTripType/{riderId}
HIMCAB_OFFERS_ALL_PATH=/api/rider/offer/get-all
HIMCAB_OFFERS_PAGE_SIZE=50
# How many coupons one reply may name (the app's offers screen has the full list).
MAX_OFFERS_IN_REPLY=3

# ─────────────────────────────────────────────
# Conversation policy (see app/agent/slots.py)
# ─────────────────────────────────────────────
# How many times one detail may be asked for before the agent proceeds with a
# stated assumption instead. Also caps consecutive turns that tell us nothing new.
MAX_CLARIFICATION_ATTEMPTS=2
# Trip length used when the user never gives one — always disclosed in the reply.
DEFAULT_TRIP_DURATION_DAYS=3

# ─────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
# Enforced per server instance, so an N-instance deployment allows N x this
# per rider. Put a hard global limit at the gateway if you need one.
RATE_LIMIT_PER_MINUTE=30
