# ─────────────────────────────────────────────
# GCP Configuration
# ─────────────────────────────────────────────
GCP_PROJECT_ID=himcab-tourist-assistant
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# ─────────────────────────────────────────────
# Vertex AI / Gemini
# ─────────────────────────────────────────────
VERTEX_AI_LOCATION=us-central1
GEMINI_PRO_MODEL=gemini-2.5-flash-lite
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite

# ─────────────────────────────────────────────
# Firebase Auth
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=himcab-tourist-assistant
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# ─────────────────────────────────────────────
# Firestore
# ─────────────────────────────────────────────
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_SESSIONS_COLLECTION=trip_sessions
FIRESTORE_USERS_COLLECTION=user_profiles

# ─────────────────────────────────────────────
# Redis / Cloud Memorystore
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_WEATHER=1800       # 30 minutes
REDIS_TTL_PLACES=86400       # 24 hours
REDIS_TTL_SESSION=7200       # 2 hours

# ─────────────────────────────────────────────
# External APIs
# ─────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweather-api-key
#GOOGLE_MAPS_API_KEY=your-google-maps-api-key
#GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ─────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# ─────────────────────────────────────────────
# Pub/Sub (Alert Pipeline)
# ─────────────────────────────────────────────
PUBSUB_ALERT_TOPIC=himachal-travel-alerts
PUBSUB_ALERT_SUBSCRIPTION=alert-consumer-sub
