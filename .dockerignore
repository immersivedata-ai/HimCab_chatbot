# ── Exclude from Docker build context ─────────────────────────────────────────
.git
.gitignore
.env
.env.example
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
__pycache__

# ── Documentation & tooling (not needed in container) ─────────────────────────
docs/
scripts/
tests/
graphify-out/
.benchmarks/
.agents/

# The browser test clients are NOT deployed. The service is an API only; the pages are
# kept in the repo for local poking (open the file, point it at http://localhost:8000)
# and are excluded from the image so the deployed URL is nothing but the contract.
frontend/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Config files not needed in container ──────────────────────────────────────
Makefile
*.md
!README.md
pyproject.toml
ruff.toml
.pre-commit-config.yaml
deploy.ps1

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
test_results.txt
