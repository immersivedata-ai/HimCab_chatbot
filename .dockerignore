# ── Exclude from Docker build context ─────────────────────────────────────────
.git
.gitignore
.env
.env.example
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
__pycache__

# ── Documentation & tooling (not needed in container) ─────────────────────────
docs/
scripts/
tests/
graphify-out/
.benchmarks/
.agents/

# The browser test clients DO ship. They drive the three workflows end to end against
# the public endpoints, and app/main.py serves them on any non-production APP_ENV — so
# they have to be in the image for the deployed URL to have anything to serve. Setting
# APP_ENV=production turns them off at runtime without rebuilding.
#
# Their tooling is another matter: nothing is built from these, so they are weight.
frontend/node_modules/
frontend/package-lock.json

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Config files not needed in container ──────────────────────────────────────
Makefile
*.md
!README.md
pyproject.toml
ruff.toml
.pre-commit-config.yaml
deploy.ps1

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
test_results.txt
