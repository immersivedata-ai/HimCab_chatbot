# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — Him Cab AI Travel Assistant
#
# NOTE ON `*.json` (see the Secrets section): all JSON is ignored by default,
# because GCP service-account keys are JSON and one committed by accident is a
# credential leak that survives in git history forever. Legitimate JSON must be
# un-ignored explicitly with a `!` line. If a JSON file you added isn't showing
# up in `git status`, that rule is why — add a negation rather than deleting it.
# ══════════════════════════════════════════════════════════════════════════════

# ── Secrets & credentials — NOTHING here may ever be committed ────────────────
.env
.env.*
!.env.example
secrets/
credentials/

*.json
!package.json
!package-lock.json
!tsconfig.json
!.eslintrc.json

# Key material, in every form it tends to arrive in
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.gpg
*.asc

# Named credential files, in case a `!` negation above ever widens the net
firebase-service-account.json
service-account.json
gcp-service-account.json
firebase-adminsdk.json
*-firebase-adminsdk-*.json
*credentials*.json
*serviceaccount*.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/
develop-eggs/
sdist/
wheels/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.direnv/
.python-version

# ── Testing, typing & linting caches ─────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.tox/
.nox/
.hypothesis/
.benchmarks/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
test_results.txt
.cache/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
.npm/
.pnp.*
.yarn/
.parcel-cache/
.next/
.nuxt/
*.tsbuildinfo

# ── Local databases & dumps ───────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql

# ── Logs, PIDs & temp files ───────────────────────────────────────────────────
*.log
logs/
*.pid
*.seed
*.bak
*.orig
*.rej
*.tmp
*.swp
*.swo
*~
tmp/
temp/
scratch/

# ── Infrastructure state (never commit — contains resource ids and secrets) ───
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# ── Editors & IDEs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.ipynb_checkpoints/

# ── Claude Code — machine-local state (shared settings.json stays tracked) ────
.claude/settings.local.json
.claude/worktrees/
.claude/tasks/

# ── Auto-generated ────────────────────────────────────────────────────────────
graphify-out/

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
